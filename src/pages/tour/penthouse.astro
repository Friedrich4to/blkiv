---
import Layout from '../../layouts/Layout.astro';
import TourNav from '../../components/TourNav.astro';
import '@photo-sphere-viewer/core/index.css';
import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
---

<Layout title="Tour Penthouse" bare={true}>
  <TourNav />
  <div class="viewer-wrap">
    <div id="psv-container"></div>
  </div>
</Layout>

<style>
  .viewer-wrap {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  #psv-container {
    width: 100%;
    height: 100%;
  }
</style>

<style is:global>
  #psv-container .psv-loader { display: none; }
</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';

  const nodes = [
    {
      id: 't1',
      panorama: '/tour/penthouse/t1.avif',
      name: 'Terraza',
      links: [
        { nodeId: '1',  position: { yaw: '90deg',   pitch: '-25deg' } },
        { nodeId: 't2', position: { yaw: '0deg', pitch: '-15deg' } },
      ],
    },
    {
      id: 't2',
      panorama: '/tour/penthouse/t2.avif',
      name: 'Terraza 2',
      links: [
        { nodeId: 't1', position: { yaw: '180deg',   pitch: '-15deg' } },
        { nodeId: 't3', position: { yaw: '0deg', pitch: '-15deg' } },
      ],
    },
    {
      id: 't3',
      panorama: '/tour/penthouse/t3.avif',
      name: 'Terraza 3',
      links: [
        { nodeId: 't2', position: { yaw: '190deg', pitch: '-10deg' } },
      ],
    },
    {
      id: '1',
      panorama: '/tour/penthouse/1.avif',
      name: 'Entrada',
      links: [
        { nodeId: 't1', position: { yaw: '-135deg', pitch: '-25deg' } },
        { nodeId: '2',  position: { yaw: '30deg',    pitch: '-25deg' } },
        { nodeId: '6',  position: { yaw: '0deg',  pitch: '-25deg' } },
      ],
    },
    {
      id: '2',
      panorama: '/tour/penthouse/2.avif',
      name: 'Comedor',
      links: [
        { nodeId: '1', position: { yaw: '-120deg', pitch: '-15deg' } },
        { nodeId: '3', position: { yaw: '110deg', pitch: '-15deg' } },
        { nodeId: '4', position: { yaw: '60deg',   pitch: '-25deg' } },
      ],
    },
    {
      id: '3',
      panorama: '/tour/penthouse/3.avif',
      name: 'Sala',
      links: [
        { nodeId: '2', position: { yaw: '-45deg', pitch: '-20deg' } },
        { nodeId: '4', position: { yaw: '-30deg',   pitch: '-15deg' } },
        { nodeId: '9', position: { yaw: '50deg',  pitch: '-15deg' } },
      ],
    },
    {
      id: '4',
      panorama: '/tour/penthouse/4.avif',
      name: 'Hab. Principal',
      links: [
        { nodeId: '2', position: { yaw: '180deg', pitch: '-15deg' } },
        { nodeId: '5', position: { yaw: '-55deg',   pitch: '-15deg' } },
      ],
    },
    {
      id: '5',
      panorama: '/tour/penthouse/5.avif',
      name: 'Baño Principal',
      links: [
        { nodeId: '4', position: { yaw: '120deg', pitch: '-15deg' } },
      ],
    },
    {
      id: '6',
      panorama: '/tour/penthouse/6.avif',
      name: 'Pasillo',
      links: [
        { nodeId: '1', position: { yaw: '180deg', pitch: '-20deg' } },
        { nodeId: '7', position: { yaw: '-90deg', pitch: '-25deg' } },
        { nodeId: '8', position: { yaw: '0deg',  pitch: '-25deg' } },
        { nodeId: '2', position: { yaw: '145deg',  pitch: '-35deg' } },
      ],
    },
    {
      id: '7',
      panorama: '/tour/penthouse/7.avif',
      name: 'Hab. Secundaria',
      links: [
        { nodeId: '6', position: { yaw: '90deg', pitch: '-20 deg' } },
      ],
    },
    {
      id: '8',
      panorama: '/tour/penthouse/8.avif',
      name: 'Baño visitas',
      links: [
        { nodeId: '6', position: { yaw: '180deg', pitch: '-35 deg' } },
      ],
    },
    {
      id: '9',
      panorama: '/tour/penthouse/9.avif',
      name: 'Balcón',
      links: [
        { nodeId: '2', position: { yaw: '-90deg', pitch: '-15deg' } },
      ],
    },
  ];

  new Viewer({
    container: document.getElementById('psv-container') as HTMLElement,
    navbar: false,
    loadingTxt: '',
    defaultZoomLvl: 0,
    plugins: [
      [VirtualTourPlugin, {
        positionMode: 'manual',
        renderMode: '2d',
        arrowStyle: { size: { width: 40, height: 40 } },
        startNodeId: '1',
        nodes,
        transitionOptions: {
          showLoader: false,
          speed: '20rpm',
          effect: 'fade',
          rotation: true,
        },
      }],
    ],
  });
</script>
