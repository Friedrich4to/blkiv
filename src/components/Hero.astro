---
---

<section id="hero" class="relative h-svh overflow-hidden">
  <img
    src="/hero_section_img.avif"
    alt="BLK Residences IV"
    class="absolute inset-0 w-full h-full object-cover object-center md:object-center object-[center_30%]"
  />

  <!-- Desktop: centered-left, elevated. Mobile: near top -->
  <div class="absolute inset-0 flex md:items-center items-start pointer-events-none">
    <div class="pl-[8vw] flex flex-col gap-7 md:translate-y-[-45%] translate-y-0 pt-[20vw] md:pt-0 pointer-events-auto">
      <img
        src="/logo.svg"
        alt="BLK Residences IV"
        class="w-64 md:w-80 lg:w-96"
      />
      <a
        href="#descripcion"
        class="flex items-center gap-3 text-second text-sm font-medium no-underline"
      >
        <span>Conozca más del proyecto</span>
        <div class="mouse-icon">
          <div class="mouse-wheel"></div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  /* Mobile: push image down to show more sky */
  @media (max-width: 767px) {
    #hero img {
      object-position: center 40%;
    }
  }

  .mouse-icon {
    position: relative;
    width: 18px;
    height: 28px;
    border: 2px solid #202020;
    border-radius: 9px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }

  .mouse-wheel {
    position: absolute;
    top: 5px;
    width: 3px;
    height: 5px;
    background: #202020;
    border-radius: 2px;
    animation: scroll-wheel 1.6s ease-in-out infinite;
  }

  @keyframes scroll-wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(9px);
      opacity: 0;
    }
    71% {
      transform: translateY(0);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
