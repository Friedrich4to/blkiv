---
type Unit = {
  key: string;
  tab: [string, string];
  images: string[];
  tourUrl: string;
  features: (string | null)[];
};

const units: Unit[] = [
  {
    key: 'bloque01',
    tab: ['Bloque ', '01'],
    images: ['/assets/units/bloque_1.png'],
    tourUrl: '#',
    features: [
      '<strong>Dimensiones:</strong> 80.80 m²',
      '<strong>2</strong> Habitaciones',
      'Habitación principal con <strong>baño</strong>',
      '<strong>Walking closet</strong> en Hab. principal',
      null,
      '<strong>2</strong> Parqueos',
      'Sala – Comedor',
      'Área de lavado',
      'Baño común',
      'Closets de ropa blanca',
      'Locker de <strong>5.2 m²</strong>',
    ],
  },
  {
    key: 'bloque02',
    tab: ['Bloque ', '02'],
    images: ['/assets/units/bloque_2.png'],
    tourUrl: '#',
    features: [
      '<strong>Dimensiones:</strong> 70.60 m²',
      '<strong>2</strong> Habitaciones',
      'Habitación principal con <strong>baño</strong>',
      null,
      '<strong>2</strong> Parqueos',
      'Sala – Comedor',
      'Área de lavado',
      'Baño común',
    ],
  },
  {
    key: 'bloque03',
    tab: ['Bloque ', '03'],
    images: ['/assets/units/bloque_3.png'],
    tourUrl: '#',
    features: [
      '<strong>Dimensiones:</strong> 80.80 m²',
      '<strong>2</strong> Habitaciones',
      'Habitación principal con <strong>baño</strong>',
      '<strong>Walking closet</strong> en Hab. principal',
      null,
      '<strong>2</strong> Parqueos',
      'Sala – Comedor',
      'Área de lavado',
      'Baño común',
      'Closets de ropa blanca',
      'Locker de <strong>4.2 m²</strong>',
    ],
  },
  {
    key: 'penthouses',
    tab: ['', 'Penthouses'],
    images: ['/assets/units/penth_1.png', '/assets/units/penth_2.png'],
    tourUrl: '#',
    features: [
      '<strong>Dimensiones:</strong> 85.60 m²',
      '<strong>Terraza:</strong> 53 m²',
      '<strong>2</strong> Habitaciones',
      'Habitación principal con <strong>baño</strong>',
      '<strong>Walking closet</strong> en Hab. principal',
      null,
      '<strong>2</strong> Parqueos',
      'Sala – Comedor',
      'Área de lavado',
      'Baño común',
      'Closets de ropa blanca',
      'Locker de <strong>5.2 m²</strong>',
    ],
  },
];

const defaultUnit = units[0];
const defaultKey = defaultUnit.key;

const unitsJson = JSON.stringify(
  Object.fromEntries(units.map(u => [u.key, {
    images: u.images,
    tourUrl: u.tourUrl,
    features: u.features,
  }]))
);
---

<section id="unidades" class="px-[4vw] py-16">
  <script is:inline type="application/json" id="u-data" set:html={unitsJson}></script>

  <div class="max-w-7xl mx-auto">

    <h2 class="font-display font-bold text-4xl md:text-5xl uppercase mb-10 tracking-tight">
      Tipos de Unidades
    </h2>

    <nav class="flex flex-wrap items-center gap-2 mb-10" aria-label="Tipo de unidad">
      {units.map(u => (
        <button
          data-tab={u.key}
          data-active={u.key === defaultKey ? '' : undefined}
          class="u-tab font-display cursor-pointer px-4 py-1.5 transition-all duration-200 text-[18px]"
        >
          {u.tab[0]}<strong>{u.tab[1]}</strong>
        </button>
      ))}
    </nav>

    <div id="u-row" class="flex flex-col md:flex-row gap-12">

      <!-- Left: characteristics -->
      <div id="u-left-col" class="w-full md:w-1/2 flex flex-col justify-start gap-6">
        <p class="text-[14px] uppercase tracking-widest text-second/50">Caracteristicas</p>

        <ul id="u-features" class="flex flex-col gap-2">
          {defaultUnit.features.map(f =>
            f === null
              ? <li class="text-[24px] font-bold leading-none text-second/25">—</li>
              : <li class="text-[24px] leading-snug text-second/80" set:html={f} />
          )}
        </ul>

        <a
          id="u-tour-btn"
          href={defaultUnit.tourUrl}
          class="inline-flex items-center self-start mt-2 px-6 py-3 rounded-sm bg-second text-white text-[18px] no-underline leading-none transition-colors hover:bg-second/80"
        >
          Explorar Tour virtual
        </a>

        <div hidden aria-hidden="true">
          {units.map(u => (
            <img id={`fp-${u.key}`} src="/assets/unit-p1.svg" alt="" />
          ))}
        </div>
      </div>

      <!-- Right: carousel with floor plan images -->
      <div class="w-full md:w-1/2 flex flex-col gap-4 order-first md:order-none">
        <div class="u-embla relative">
          <div class="u-embla__viewport">
            <div class="u-embla__container" id="u-slides">
              {defaultUnit.images.map((src, i) => (
                <div class="u-embla__slide">
                  <img
                    src={src}
                    alt={`Plano ${defaultUnit.tab.join('')}${i > 0 ? ` ${i + 1}` : ''}`}
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>

          <button class="u-embla__btn u-embla__prev" aria-label="Anterior">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="u-embla__btn u-embla__next" aria-label="Siguiente">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <div class="u-embla__dots" aria-hidden="true"></div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  /* ── Tabs ───────────────────────────────────── */
  .u-tab {
    font-weight: 500;
    border-radius: 4px;
    color: color-mix(in srgb, var(--color-second) 50%, transparent);
  }
  .u-tab:hover {
    color: var(--color-second);
  }
  .u-tab[data-active] {
    background: var(--color-second);
    color: var(--color-white);
    font-weight: 700;
  }

  /* ── Left column fixed height on desktop ───── */
  @media (min-width: 768px) {
    #u-left-col {
      min-height: 60svh;
    }
  }

  /* ── Carousel ───────────────────────────────── */
  .u-embla {
    position: relative;
    width: 100%;
  }
  .u-embla__viewport {
    overflow: hidden;
    width: 100%;
    height: 50svh;
    border-radius: 16px;
    background: #f5f5f0;
  }

  .u-embla__container {
    display: flex;
    user-select: none;
    height: 100%;
  }
  .u-embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    width: 100%;
    height: 100%;
  }
  .u-embla__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ── Carousel buttons ───────────────────────── */
  .u-embla__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(29, 29, 29, 0.82);
    color: #F4F4F4;
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
  }
  .u-embla__btn:hover { background: rgba(29, 29, 29, 1); }
  .u-embla__btn:disabled { display: none; }
  .u-embla__prev { left: 10px; }
  .u-embla__next { right: 10px; }

  /* ── Dots ───────────────────────────────────── */
  .u-embla__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    min-height: 8px;
  }
  .u-embla__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(29, 29, 29, 0.25);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .u-embla__dot.is-selected {
    background: #1D1D1D;
    transform: scale(1.3);
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  type UnitData = {
    images: string[];
    tourUrl: string;
    features: (string | null)[];
  };

  const allUnits: Record<string, UnitData> = JSON.parse(
    document.getElementById('u-data')!.textContent!
  );

  const viewport   = document.querySelector<HTMLElement>('.u-embla__viewport')!;
  const slidesEl   = document.getElementById('u-slides')!;
  const dotsEl     = document.querySelector<HTMLElement>('.u-embla__dots')!;
  const prevBtn    = document.querySelector<HTMLButtonElement>('.u-embla__prev')!;
  const nextBtn    = document.querySelector<HTMLButtonElement>('.u-embla__next')!;
  const featuresEl = document.getElementById('u-features')!;
  const tourBtn    = document.getElementById('u-tour-btn') as HTMLAnchorElement;
  const tabs       = document.querySelectorAll<HTMLButtonElement>('.u-tab');

  let embla: ReturnType<typeof EmblaCarousel> | null = null;

  function updateButtons() {
    const single = embla!.scrollSnapList().length <= 1;
    prevBtn.disabled = single;
    nextBtn.disabled = single;
  }

  function buildDots() {
    dotsEl.innerHTML = '';
    const count = embla!.scrollSnapList().length;
    if (count <= 1) return;
    const dots: HTMLButtonElement[] = Array.from({ length: count }, (_, i) => {
      const dot = document.createElement('button');
      dot.className = 'u-embla__dot';
      dot.setAttribute('aria-label', `Imagen ${i + 1}`);
      dot.addEventListener('click', () => embla!.scrollTo(i));
      dotsEl.appendChild(dot);
      return dot;
    });
    function sync() {
      const sel = embla!.selectedScrollSnap();
      dots.forEach((d, i) => d.classList.toggle('is-selected', i === sel));
    }
    embla!.on('select', sync);
    sync();
  }

  function initEmbla() {
    if (embla) embla.destroy();
    embla = EmblaCarousel(viewport, { loop: false, align: 'start', containScroll: 'trimSnaps' });
    updateButtons();
    buildDots();
  }

  prevBtn.addEventListener('click', () => embla?.scrollPrev());
  nextBtn.addEventListener('click', () => embla?.scrollNext());

  const leftCol = document.getElementById('u-left-col')!;
  const dotsAreaPx = 24; // gap-4 (16px) + dots min-height (8px)

  function syncCarouselToLeftCol() {
    if (window.innerWidth < 768) {
      viewport.style.height = '';
      return;
    }
    requestAnimationFrame(() => {
      const h = leftCol.offsetHeight - dotsAreaPx;
      viewport.style.height = `${Math.max(h, 200)}px`;
      embla?.reInit();
    });
  }

  window.addEventListener('resize', syncCarouselToLeftCol);

  function featureItem(f: string | null): string {
    if (f === null) {
      return `<li class="text-[24px] font-bold leading-none text-second/25">—</li>`;
    }
    return `<li class="text-[24px] leading-snug text-second/80">${f}</li>`;
  }

  function switchTab(type: string) {
    const unit = allUnits[type];
    if (!unit) return;

    tabs.forEach(btn => {
      if (btn.dataset.tab === type) {
        btn.setAttribute('data-active', '');
      } else {
        btn.removeAttribute('data-active');
      }
    });

    featuresEl.innerHTML = unit.features.map(featureItem).join('');
    tourBtn.href = unit.tourUrl;

    slidesEl.innerHTML = unit.images
      .map((src, i) => `<div class="u-embla__slide"><img src="${src}" alt="Plano ${i + 1}" loading="lazy" /></div>`)
      .join('');

    initEmbla();
    syncCarouselToLeftCol();
  }

  tabs.forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab!));
  });

  initEmbla();
  document.fonts.ready.then(syncCarouselToLeftCol);
</script>
