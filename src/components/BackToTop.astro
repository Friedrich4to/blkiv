<button
  id="back-to-top"
  aria-label="Volver arriba"
  class="fixed bottom-6 right-6 z-50 w-12 h-12 rounded-sm bg-second text-white flex items-center justify-center opacity-0 pointer-events-none transition-[opacity,background-color] duration-300 ease-in-out cursor-pointer hover:bg-base"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 15l-6-6-6 6"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top') as HTMLButtonElement;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 200) {
      btn.classList.remove('opacity-0', 'pointer-events-none');
      btn.classList.add('opacity-100');
    } else {
      btn.classList.add('opacity-0', 'pointer-events-none');
      btn.classList.remove('opacity-100');
    }
  }, { passive: true });

  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
