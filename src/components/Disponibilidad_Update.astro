---
interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

interface Props {
  units: URow[];
  hideHeader?: boolean;
}

const { units: rawUnits, hideHeader = false } = Astro.props;

const units = rawUnits.map(u => ({
  id:             u.numero,
  numero:         u.numero,
  disponibilidad: u.disponibilidad,
  m2:             u.m2,
  patio_m2:       u.patio_m2,
  terraza_m2:     u.terraza_m2,
  m2_total:       u.m2_total,
  tourUrl:        u.tour_url ?? '#',
  tourHref:       u.numero.startsWith('4') && u.numero !== '402' ? '/tour/penthouse' : (u.numero.endsWith('2') ? '/tour/tipo2' : '/tour/tipo1'),
  precio:         u.precio,
}));

const byFloorDesc = (a: typeof units[0], b: typeof units[0]) =>
  parseInt(b.numero[0]) - parseInt(a.numero[0]);

const blocks = [
  { label: 'Penthouses', units: units.filter(u => u.numero.startsWith('4') && u.numero !== '402').sort(byFloorDesc) },
  { label: 'Bloque 03', units: units.filter(u => u.numero.endsWith('3') && !u.numero.startsWith('4')).sort(byFloorDesc) },
  { label: 'Bloque 02', units: units.filter(u => u.numero.endsWith('2')).sort(byFloorDesc) },
  { label: 'Bloque 01', units: units.filter(u => u.numero.endsWith('1') && !u.numero.startsWith('4')).sort(byFloorDesc) },
];

const statusLabel: Record<string, string> = {
  available: 'Disponible',
  reserved:  'Reservado',
  sold:      'Vendido',
};

const statusDot: Record<string, string> = {
  available: 'bg-green',
  reserved:  'bg-yellow',
  sold:      'bg-red',
};
const statusText: Record<string, string> = {
  available: 'text-green',
  reserved:  'text-yellow',
  sold:      'text-red',
};
const statusBg: Record<string, string> = {
  available: 'bg-green/10',
  reserved:  'bg-yellow/10',
  sold:      'bg-red/10',
};

const svgFill: Record<string, string> = {
  available: '#202020',
  reserved:  '#B8900D',
  sold:      '#C23E3E',
};
const svgBaseOpacity: Record<string, string> = {
  available: '0',
  reserved:  '0.2',
  sold:      '0.2',
};

const unitStatusMap = Object.fromEntries(units.map(u => [u.id, u.disponibilidad]));

// Hotspot shapes extracted from the individual unit SVGs (viewBox 0 0 1158 890).
// SVG naming: first digit = bloque (column), second = nivel (row from bottom).
// Mapped to DB unit IDs: DB first digit = nivel, DB last digit = bloque.
const svgShapes: Array<
  | { dbId: string; type: 'polygon'; points: string }
  | { dbId: string; type: 'rect'; x: number; y: number; w: number; h: number }
> = [
  // Bloque 01 — left column
  { dbId: '101', type: 'polygon', points: '325.14 682.25 35.96 680.27 35.96 810.43 180.55 810.43 180.55 834.56 331.87 838.52 331.87 723.79 315.65 723.79 314.86 709.15 331.87 699.26 331.87 692.93 325.14 692.93' },
  { dbId: '201', type: 'rect',    x: 35.69, y: 515.31, w: 289.45, h: 159.43 },
  { dbId: '301', type: 'polygon', points: '325.14 350.34 35.69 350.34 36.09 507 325.14 507' },
  { dbId: '401', type: 'polygon', points: '325.14 184.58 181.14 186.96 181.14 131.97 35.56 134.34 35.56 337.68 325.14 336.89 325.14 184.58' },
  // Bloque 02 — middle column
  { dbId: '102', type: 'polygon', points: '482.07 698.74 482.07 862.52 718.64 862.52 721.8 698.74' },
  { dbId: '202', type: 'polygon', points: '336.48 515.31 338.86 674.74 721.8 679.62 721.8 513.99' },
  { dbId: '302', type: 'rect',    x: 336.48, y: 345.07, w: 388.48, h: 161.93 },
  { dbId: '402', type: 'polygon', points: '724.97 158.34 331.74 165.46 331.74 337.68 724.97 335.57' },
  // Bloque 03 — right column
  { dbId: '103', type: 'polygon', points: '733.67 679.62 733.67 848.54 914.86 850.91 918.02 839.04 1103.56 835.09 1103.56 813.33 1128.88 813.33 1128.88 808.98 1113.05 793.95 1111.87 679.62' },
  { dbId: '203', type: 'polygon', points: '734.2 670.35 1126.04 671.93 1126.04 662.74 1122.88 661.25 1123.08 630.99 1112.1 623.57 1113.19 517.65 735.22 513.99 734.2 670.35' },
  { dbId: '303', type: 'polygon', points: '735.22 346.48 735.22 500.24 1123.57 500.24 1123.57 471.82 1111.8 472.35 1111.51 358.52 1126.04 352.78 1125.65 345.07 1122.62 345.16' },
  { dbId: '403', type: 'polygon', points: '1101.48 111.23 914.16 113.8 914.16 157.05 734.43 161.01 735.62 329.54 1122.52 329.54 1122.85 312.92 1111.7 312.86 1111.51 205.85 1125.22 194.64 1125.35 186.07 1111.37 185.8 1111.51 143.74 1101.48 144.13 1101.48 111.23' },
];

function getFloorLabel(numero: string): string {
  if (numero.startsWith('1')) return 'Nivel 1';
  if (numero.startsWith('2')) return 'Nivel 2';
  if (numero.startsWith('3')) return 'Nivel 3';
  if (numero === '402')       return 'Nivel 4';
  return 'Penthouse';
}
---

<section id="disponibilidad" class:list={["px-[4vw]", hideHeader ? "pt-4 pb-16" : "py-16"]}>
  <div class="max-w-7xl mx-auto">

    {!hideHeader && (
      <div class="mb-8 flex items-center gap-4 flex-wrap">
        <h2 class="font-display font-bold text-3xl uppercase">Unidades Disponibles</h2>
        <button
          id="du-pdf-btn"
          class="flex items-center gap-2 px-5 py-2.5 text-sm rounded-md bg-gray-100 border border-base/20 hover:bg-second hover:text-white transition-colors duration-500 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar lista PDF
        </button>
      </div>
    )}

    <!-- Two-column layout: list left, sticky map right -->
    <div class="flex flex-col lg:grid lg:grid-cols-[35%_1fr] gap-8 items-start">

      <!-- Unit list grouped by block -->
      <div class="order-2 lg:order-1 flex flex-col gap-8">
        {blocks.map(block => (
          <div>
            <h3 class="font-sans font-bold text-xs uppercase tracking-[0.2em] text-base mb-3">
              {block.label}
            </h3>
            <div class="flex flex-col gap-2">
              {block.units.map(unit => (
                <div
                  class="du-unit-card border border-second/20 rounded-xl overflow-hidden cursor-pointer select-none bg-white"
                  data-unit={unit.id}
                >

                  <!-- Collapsed header -->
                  <div class="flex items-center justify-between px-4 py-3 gap-3">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="font-display font-bold text-lg shrink-0">{unit.numero}</span>
                      <span class:list={[
                        'flex items-center gap-1.5 text-sm shrink-0 px-2 py-0.5 rounded-full',
                        statusText[unit.disponibilidad],
                        statusBg[unit.disponibilidad],
                      ]}>
                        <span class:list={['w-2 h-2 rounded-full shrink-0', statusDot[unit.disponibilidad]]}></span>
                        {statusLabel[unit.disponibilidad]}
                      </span>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-sm text-second/40">{unit.m2_total} m²</span>
                      {!['reserved','sold'].includes(unit.disponibilidad) && (
                        <span class="font-bold text-sm text-second">US$ {unit.precio.toLocaleString('en-US')}</span>
                      )}
                      <svg
                        class="du-chevron shrink-0 transition-transform duration-200"
                        xmlns="http://www.w3.org/2000/svg"
                        width="14" height="14" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round"
                      >
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Expanded detail (hidden by default) -->
                  <div class="du-unit-detail hidden px-4 pb-4">
                    <div class="flex flex-col gap-3 pt-3 border-t border-second/10">

                      <!-- Info row -->
                      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-second/75">
                        <span class="font-semibold">{getFloorLabel(unit.numero)}</span>
                        <span class="flex items-center gap-1.5">
                          <img src="/assets/icons/size.svg" alt="" class="h-4 w-auto brightness-0" aria-hidden="true" />
                          <span class="opacity-40">{unit.m2} m²</span>
                          <span class="opacity-30 select-none mx-0.5">|</span>
                          {unit.m2_total} m²
                        </span>
                        <span class="flex items-center gap-1.5">
                          <img src="/assets/icons/room.svg" alt="" class="h-4 w-auto brightness-0" aria-hidden="true" />
                          2
                        </span>
                        <span class="flex items-center gap-1.5">
                          <img src="/assets/icons/bath.svg" alt="" class="h-4 w-auto brightness-0" aria-hidden="true" />
                          2
                        </span>
                        <span class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-auto text-second" aria-hidden="true">
                            <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/>
                          </svg>
                          2
                        </span>
                      </div>

                      <!-- Tour button -->
                      <a
                        href={unit.tourHref}
                        class="block text-center px-4 py-3 rounded-lg bg-second text-white font-bold text-sm leading-none hover:bg-second/80 transition-colors duration-200 no-underline"
                      >
                        Explorar Tour virtual
                      </a>

                      <!-- Ficha técnica button -->
                      <span
                        class="block text-center px-4 py-3 rounded-lg border border-second/10 text-second/30 text-sm font-medium cursor-not-allowed select-none"
                      >
                        Descargar ficha técnica
                      </span>

                    </div>
                  </div>

                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Interactive floor plan map — top on mobile, sticky right on desktop -->
      <div class="order-1 lg:order-2 lg:sticky lg:top-8 self-start w-full">
        <div class="relative">
          <svg
            class="absolute inset-0 w-full h-full z-10"
            viewBox="0 0 1158 890"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            {svgShapes.map(shape => {
              const status = unitStatusMap[shape.dbId] ?? 'available';
              const baseOp = svgBaseOpacity[status];
              const fill   = svgFill[status];
              const common = {
                'data-unit':         shape.dbId,
                class:               'du-unit-shape',
                style:               `opacity:${baseOp};cursor:pointer;transition:opacity 0.2s`,
                'data-base-opacity': baseOp,
                fill,
              };
              return shape.type === 'polygon'
                ? <polygon {...common} points={shape.points} />
                : <rect    {...common} x={shape.x} y={shape.y} width={shape.w} height={shape.h} />;
            })}
          </svg>

          <img
            src="/assets/unidades/base.png"
            alt="Plano del edificio"
            class="relative w-full block pointer-events-none z-0"
          />
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function getShape(unitId: string) {
    return document.querySelector<SVGRectElement>(`.du-unit-shape[data-unit="${unitId}"]`);
  }

  function isOpen(card: HTMLElement) {
    return !card.querySelector<HTMLElement>('.du-unit-detail')!.classList.contains('hidden');
  }

  function openUnit(unitId: string) {
    document.querySelectorAll<HTMLElement>('.du-unit-card').forEach(card => {
      const detail  = card.querySelector<HTMLElement>('.du-unit-detail')!;
      const chevron = card.querySelector<SVGElement>('.du-chevron')!;
      const shape   = getShape(card.dataset.unit!);
      const baseOp  = shape?.dataset.baseOpacity ?? '0';

      if (card.dataset.unit === unitId) {
        const opening = detail.classList.contains('hidden');
        detail.classList.toggle('hidden', !opening);
        chevron.style.transform = opening ? 'rotate(180deg)' : '';
        if (shape) shape.style.opacity = opening ? '0.8' : baseOp;
        if (opening) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        detail.classList.add('hidden');
        chevron.style.transform = '';
        if (shape) shape.style.opacity = baseOp;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.du-unit-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      openUnit(card.dataset.unit!);
    });

    card.addEventListener('mouseenter', () => {
      if (isOpen(card)) return;
      const shape = getShape(card.dataset.unit!);
      if (shape) shape.style.opacity = '0.6';
    });
    card.addEventListener('mouseleave', () => {
      if (isOpen(card)) return;
      const shape = getShape(card.dataset.unit!);
      if (shape) shape.style.opacity = shape.dataset.baseOpacity ?? '0';
    });
  });

  document.querySelectorAll<SVGRectElement>('.du-unit-shape').forEach(shape => {
    shape.addEventListener('click', () => openUnit(shape.dataset.unit!));
    shape.addEventListener('mouseenter', () => {
      if (shape.style.opacity !== '0.8') shape.style.opacity = '0.4';
    });
    shape.addEventListener('mouseleave', () => {
      if (shape.style.opacity === '0.4') shape.style.opacity = shape.dataset.baseOpacity ?? '0';
    });
  });

  const pdfBtn = document.getElementById('du-pdf-btn') as HTMLButtonElement | null;
  pdfBtn?.addEventListener('click', async () => {
    const originalHTML = pdfBtn.innerHTML;
    pdfBtn.disabled = true;
    pdfBtn.textContent = 'Generando PDF…';

    try {
      const res = await fetch('/api/pdf', { method: 'POST' });
      if (!res.ok) throw new Error();

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'listado-precios-blkr4.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch {
      alert('Error generando el PDF. Inténtalo de nuevo.');
    } finally {
      pdfBtn.disabled = false;
      pdfBtn.innerHTML = originalHTML;
    }
  });
</script>
