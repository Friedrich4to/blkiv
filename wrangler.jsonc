{
	"compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat_v2"],
	"name": "blkr4",
	"account_id": "670e6731f4a6cd43490e12eb4357e19e",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
  "d1_databases": [
